// wrangler.jsonc — הגדרות פריסה ל-Cloudflare Workers
// לפני deploy ראשון: הריץ `npm run kv:create` והדבק את ה-id שיתקבל במקום ה-placeholder.
// ה-id הזה אינו סוד — אין כאן טוקנים או מפתחות.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "share-taxi",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SHARE_TAXI_KV",
      "id": "3e93af87c29f4d69aa264ce338c556bd"
    }
  ],
  "triggers": {
    "crons": ["0 */3 * * *"]
  }
}
